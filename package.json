{
  "name": "prismaboard",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && node scripts/adeies.mjs && vite build && node scripts/odigies-pdf.mjs",
    "preview": "vite preview --host",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "clips": "npm run build && node tests/clips/record.mjs",
    "android:sync": "vite build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tauri-apps/cli": "^2.12.1",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/playpen-sans": "^5.3.0",
    "docx-preview": "^0.4.1",
    "mathjax": "^3.2.2",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "^2.0.4"
  }
}
