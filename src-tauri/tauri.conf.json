{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrismaBoard",
  "version": "../package.json",
  "identifier": "gr.klabs.prismaboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PrismaBoard",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "maximized": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://accounts.google.com/gsi/client",
        "style-src": "'self' 'unsafe-inline' https://accounts.google.com/gsi/style",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "frame-src": "https://accounts.google.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.googleapis.com https://accounts.google.com https://api.anthropic.com https://script.google.com https://script.googleusercontent.com",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Greek", "English"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwMTQ2QUU1OEJCQzUxMDYKUldRR1VieUw1V29VQUcvWHQySVA0M3psbkp3bTR3UklOS2RiTm9sNFprenVsZ3RsWXJoUy9MMXUK",
      "endpoints": ["https://github.com/koskan83/prismaboard/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
