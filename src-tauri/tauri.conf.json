{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrismaBoard",
  "version": "../package.json",
  "identifier": "gr.grafida.whiteboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PrismaBoard",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Greek", "English"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwMTQ2QUU1OEJCQzUxMDYKUldRR1VieUw1V29VQUcvWHQySVA0M3psbkp3bTR3UklOS2RiTm9sNFprenVsZ3RsWXJoUy9MMXUK",
      "endpoints": ["https://github.com/koskan83/prismaboard/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
